import hudson.model.*

def publishStatus(String state, String context) {
    withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')]) {
        sh """
            curl -L -X POST -H "Accept: application/vnd.github+json" \
                 -H "Authorization: Bearer \$GITHUB_TOKEN" \
                 -H "X-GitHub-Api-Version: 2022-11-28" \
                 https://api.github.com/repos/\$REPO_OWNER/\$REPO_NAME/statuses/\$REPO_HASH \
                 -d '{"state":"\$state","target_url":"\$BUILD_URL","description":"","context":"\$context"}'
        """
    }
}

pipeline {
    agent any

    environment {
        BUILD_DIR = 'build'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    stages {
        stage('Environment Setup') {
            steps {
                script {
                    env.REMOTE_URL = sh(script: "git config --get remote.origin.url", returnStdout: true).trim()
                    env.REPO_PATH = sh(script: 'REPO_PATH="${REMOTE_URL#*github.com[:/]}"; echo ${REPO_PATH%.git}', returnStdout: true).trim()
                    env.REPO_OWNER = sh(script: 'echo "${REPO_PATH}" | cut -d"/" -f1', returnStdout: true).trim()
                    env.REPO_NAME = sh(script: 'echo "${REPO_PATH}" | cut -d"/" -f2', returnStdout: true).trim()
                    env.REPO_HASH = sh(script: "git rev-parse HEAD", returnStdout: true).trim()
                    publishStatus("pending", "continuous-integration/jenkins")
                }
                sh 'mkdir -p ${BUILD_DIR}'
            }
        }

        stage('CMake Configure') {
            steps {
                sh """
                    cd ${BUILD_DIR}
                    cmake ..
                """
            }
        }

        stage('Build and Unit Tests') {
            parallel {
                stage('Build Components') {
                    stages {
                        stage('Build Bootloader') {
                            steps {
                                sh """
                                    cd ${BUILD_DIR}
                                    make bootloader_bs.elf
                                """
                            }
                        }
                        stage('Build Floats') {
                            steps {
                                sh """
                                    cd ${BUILD_DIR}
                                    make floats_bs.elf
                                """
                            }
                        }
                        stage('Build Linux App') {
                            steps {
                                sh """
                                    cd ${BUILD_DIR}
                                    make pc_app_linux
                                """
                            }
                        }
                        stage('Build Windows App') {
                            steps {
                                sh """
                                    cd ${BUILD_DIR}
                                    make pc_app_windows < /dev/null > /dev/null 2>&1
                                """
                            }
                        }
                    }
                }
                stage('Build Unit Tests') {
                    steps {
                        script {
                            publishStatus("pending", "utest")
                        }
                        sh """
                            cd ${BUILD_DIR}
                            make coverage
                        """
                        sh """
                            cd ${BUILD_DIR}
                            export GTEST_OUTPUT="xml:test-results/"
                            make utest
                        """
                    }
                    post {
                        always {
                            publishHTML(target: [
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: "${BUILD_DIR}/html",
                                reportFiles: 'index.html',
                                reportName: 'Coverage Report'
                            ])
                            script {
                                junit 'build/test-results/*.xml'
                            }
                        }
                        success {
                            script {
                                publishStatus("success", "utest")
                            }
                        }
                        failure {
                            script {
                                publishStatus("failure", "utest")
                            }
                        }
                    }
                }
            }
        }

        stage('Archive Artifacts') {
            steps {
                dir(BUILD_DIR) {
                    archiveArtifacts(
                        artifacts: 'bootloader/bootloader_bs.elf, application/floats_bs.elf, dist/DigitalFloatsControl.exe, dist/DigitalFloatsControl',
                        fingerprint: true
                    )
                }
            }
        }

        stage('Publish Release') {
            steps {
                script {
                    publishStatus("success", "continuous-integration/jenkins")
                    echo "Release published successfully."
                }
            }
        }
    }

    post {
        always {
            cleanWs(
                cleanWhenNotBuilt: true,
                deleteDirs: true,
                disableDeferredWipeout: true,
                notFailBuild: true,
                patterns: [[pattern: 'build/', type: 'INCLUDE']]
            )
        }
    }
}