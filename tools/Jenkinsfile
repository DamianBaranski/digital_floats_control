import hudson.model.*

def publishStatus(String state) {
    withCredentials([string(credentialsId: 'GITHUB_TOKEN', variable: 'GITHUB_TOKEN')]) {
        sh '''
            REPO_NAME=$(basename -s .git $(git config --get remote.origin.url))
            REPO_HASH=$(git rev-parse HEAD)
            curl -L -X POST -H "Accept: application/vnd.github+json" -H "Authorization: Bearer ${GITHUB_TOKEN}" \
                 -H "X-GitHub-Api-Version: 2022-11-28" https://api.github.com/repos/DamianBaranski/${REPO_NAME}/statuses/${REPO_HASH} \
                 -d '{"state":"''' + state + '''","target_url":"''' + env.BUILD_URL + '''","description":"","context":"continuous-integration/jenkins"}'
        '''
    }
}

pipeline {
    agent any
    
    environment {
        // Project paths
        TOOLCHAIN_FILE = 'tools/toolchain.cmake'
        BUILD_DIR = 'build'
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }
    
    stages {
        stage('Environment Setup') {
            steps {
                script {
                    publishStatus("pending")
                }
                sh '''
                    # Create build directory
                    mkdir -p ${BUILD_DIR}
                '''
            }
        }
        
        stage('CMake Configure') {
            steps {
                sh '''
                    cd ${BUILD_DIR}
                    cmake .. -DCMAKE_TOOLCHAIN_FILE=../${TOOLCHAIN_FILE}
                '''
            }
        }
        
        stage('Build Bootloader') {
            steps {
                sh '''
                    cd ${BUILD_DIR}
                    make bootloader_bs.elf
                '''
            }
        }
        
        stage('Build Floats') {
            steps {
                sh '''
                    cd ${BUILD_DIR}
                    make floats_bs.elf
                '''
            }
        }
        
        stage('Build Linux App') {
            steps {
                sh '''
                    cd ${BUILD_DIR}
                    make pc_app_linux
                '''
            }
        }
        
        //stage('Build Windows App') {
        //    steps {
        //        sh '''
        //            cd ${BUILD_DIR}
        //            make pc_app_windows
        //        '''
        //    }
        //}
        
        stage('Archive Artifacts') {
            steps {
                dir(BUILD_DIR) {
                    archiveArtifacts artifacts: '''
                        bootloader/bootloader_bs.elf,
                        application/floats_bs.elf,
			dist/DigitalFloatsControl,
                    ''', fingerprint: true
                }
            }
        }
    }
    
    post {
        success {
            script {
                publishStatus("success")
            }
        }
        failure {
            script {
                publishStatus("failure")
            }
        }
        always {
            cleanWs(cleanWhenNotBuilt: true,
                    deleteDirs: true,
                    disableDeferredWipeout: true,
                    notFailBuild: true,
                    patterns: [[pattern: 'build/', type: 'INCLUDE']])
        }
    }
}

